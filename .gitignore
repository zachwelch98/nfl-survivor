# Python
__pycache__/
*.pyc
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Data caches (regenerated by `make refresh`)
data/raw/*
data/features/*
data/cache/*
!data/raw/.gitkeep
!data/features/.gitkeep
!data/cache/.gitkeep

# Node / frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Generated JSON contract (frontend/public/data/*.json) is regenerated by
# `make export` but deliberately COMMITTED, not ignored: the pipeline was
# built before the frontend in this project, so by the time the frontend
# existed there was real, live data to show (the actual current week's
# recommendation) rather than throwaway mock data to design against. A
# fresh clone works out of the box; `make export` overwrites with fresh
# numbers whenever you want them.

# OS
.DS_Store
