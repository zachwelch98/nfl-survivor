# Python
__pycache__/
*.pyc
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Data caches (regenerated by `make refresh`)
data/raw/*
data/features/*
data/cache/*
!data/raw/.gitkeep
!data/features/.gitkeep
!data/cache/.gitkeep

# Node / frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Generated JSON contract (regenerated by `make export`) — but keep mocks
frontend/public/data/*
!frontend/public/data/mock/

# OS
.DS_Store
